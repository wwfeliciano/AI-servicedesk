{
  "name": "Mentory — Notificacoes (outbox → WhatsApp/e-mail)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "helpdesk-notificacoes",
        "options": {}
      },
      "id": "webhook-notificacoes",
      "name": "Webhook notificacoes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "helpdesk-notificacoes"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-mentory-token'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_TOKEN }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "valida-token",
      "name": "Valida token",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "body",
        "options": {}
      },
      "id": "dedup-remove",
      "name": "Remove duplicados (id_evento)",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.canal }}",
                    "rightValue": "WHATSAPP",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "outputKey": "WHATSAPP"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.canal }}",
                    "rightValue": "EMAIL",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "outputKey": "EMAIL"
            }
          ]
        },
        "options": {}
      },
      "id": "roteia-canal",
      "name": "Roteia por canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://waha:3000/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Api-Key", "value": "={{ $env.WAHA_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "jsonBody": "={{ { \"session\": \"default\", \"chatId\": $json.body.destino, \"text\": $json.body.mensagem.texto } }}",
        "options": {}
      },
      "id": "envia-whatsapp",
      "name": "Envia WhatsApp (WAHA)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 200]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_SENDER }}",
        "toEmail": "={{ $json.body.destino }}",
        "subject": "={{ $json.body.mensagem.assunto }}",
        "html": "={{ $json.body.mensagem.html }}",
        "options": {}
      },
      "id": "envia-email",
      "name": "Envia e-mail (SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1140, 400],
      "notes": "Usar a credencial SMTP cadastrada no n8n (host/porta pelo .env; em dev, Mailpit)."
    }
  ],
  "connections": {
    "Webhook notificacoes": { "main": [[{ "node": "Valida token", "type": "main", "index": 0 }]] },
    "Valida token": { "main": [[{ "node": "Remove duplicados (id_evento)", "type": "main", "index": 0 }]] },
    "Remove duplicados (id_evento)": { "main": [[{ "node": "Roteia por canal", "type": "main", "index": 0 }]] },
    "Roteia por canal": {
      "main": [
        [{ "node": "Envia WhatsApp (WAHA)", "type": "main", "index": 0 }],
        [{ "node": "Envia e-mail (SMTP)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
